# One row per fixture: <name> <patch> <repatch> <round trip>.
#
# CHANGED means the patch exits 0 and the file differs. REFUSED means it exits
# non-zero and the file is untouched. NOOP is a zero exit over an unchanged
# file, which only an already patched module may report.
#
# IDEMPOTENT means a second patch over the same file exits 0 and moves nothing.
# FAILED is a refusal, which is what breaks a repeated patch.
#
# IDENTITY means the un-patch restores the fixture byte for byte. Eleven rows
# write, so no row earns its verdict by doing nothing.
crlf        CHANGED IDEMPOTENT IDENTITY
halfwrite   REFUSED NA         NA
hiddenlive  REFUSED NA         NA
indenthash  CHANGED IDEMPOTENT IDENTITY
inlinecmd   REFUSED NA         NA
lowerarg    CHANGED IDEMPOTENT IDENTITY
onehash     CHANGED IDEMPOTENT CHANGED
patched     NOOP    IDEMPOTENT CHANGED
policy      CHANGED IDEMPOTENT IDENTITY
prefixarg   CHANGED IDEMPOTENT IDENTITY
prose       REFUSED NA         NA
shipped     CHANGED IDEMPOTENT IDENTITY
spaced      CHANGED IDEMPOTENT IDENTITY
split       REFUSED NA         NA
tab         CHANGED IDEMPOTENT IDENTITY
twohash     CHANGED IDEMPOTENT IDENTITY
twomention  CHANGED IDEMPOTENT IDENTITY
upper       CHANGED IDEMPOTENT IDENTITY
